# PlatformIO: build output and downloaded libraries/toolchains (regenerated by `pio run`)
.pio/
.pioenvs/
.piolibdeps/

# VS Code + PlatformIO IDE: machine-specific generated files
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.vscode/settings.json

# Other editors
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini
*:Zone.Identifier

# Python helper scripts
__pycache__/
*.pyc
.venv/

# Credentials (Wi-Fi passwords, API keys): keep them in secrets.h, never committed
secrets.h

# Logs and dumps
*.log
